{
  "name": "moon-link",
  "version": "1.0.0",
  "description": "Secure Model Context Protocol (MCP) server for managing private Discord servers",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mock": "node dist/index.js --mock",
    "mock:sse": "node dist/index.js --sse --mock",
    "test": "tsx tests/security.test.ts && tsx tests/channel-resolve.test.ts",
    "test:connection": "tsx scripts/test-connection.ts",
    "test:web": "tsx scripts/start-web-test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "automation",
    "bot",
    "claude",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
