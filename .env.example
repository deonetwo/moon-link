# ==============================================================================
# Moon-Link Discord MCP Server Configuration
# ==============================================================================

# [REQUIRED] Discord Bot Token
# Get this from https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# [RECOMMENDED] Target Private Discord Server (Guild) ID
# Enable Developer Mode in Discord (User Settings > Advanced > Developer Mode),
# right click your private server icon, and click "Copy Server ID".
DISCORD_GUILD_ID=123456789012345678

# [SECURITY] Allowed Guild Whitelist (comma-separated)
# Enforces that NO tool or resource can ever interact with servers outside this list.
# Defaults to DISCORD_GUILD_ID if left empty.
ALLOWED_GUILD_IDS=123456789012345678

# [SAFETY] Require confirmation for destructive actions (default: true)
# When true, destructive actions (channel deletion, member kick/ban, role deletion, bulk purge)
# require passing `confirm: true`. This prevents AI agents from executing unintended destructive operations.
REQUIRE_CONFIRMATION=true

# [CONFIG] Maximum message history to retrieve per call (1-100, default: 100)
MAX_MESSAGE_HISTORY=100

# ==============================================================================
# MCP Transport Configuration
# ==============================================================================

# Transport mode: 'stdio' (for Claude Desktop, local CLI, SSH) or 'sse' (HTTP/SSE)
MCP_TRANSPORT=stdio

# HTTP / SSE Server settings (used only when MCP_TRANSPORT=sse)
MCP_PORT=3000
MCP_HOST=0.0.0.0

# [SECURITY FOR AWS / SSE] MCP Server Authorization Token
# If set, all requests to /sse and /message require 'Authorization: Bearer <token>'
# Use a strong, random secret if your AWS instance has exposed ports!
# Example: openssl rand -hex 32
MCP_AUTH_TOKEN=generate_a_secure_random_token_here
